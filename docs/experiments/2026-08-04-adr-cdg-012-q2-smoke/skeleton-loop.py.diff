+    device = dgemma_model.device
+    text_config = dgemma_model.model.config.get_text_config(decoder=True)
+    canvas_length = dgemma_model.model.config.canvas_length
+
+    generator = None
+    if seed is not None:
+        generator = torch.Generator(device=device).manual_seed(seed)
+
+    scheduler = EntropyBoundScheduler(
+        entropy_bound=entropy_bound, t_max=t_max, t_min=t_min, num_inference_steps=num_inference_steps
+    )
