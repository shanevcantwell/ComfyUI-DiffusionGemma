# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env

# Model weights / caches — never commit (multi-GB; belong in ComfyUI/models or HF cache)
*.gguf
*.safetensors
*.bin
*.pt
*.pth
models/
.cache/

# Instrumentation / trace dumps
*.trace.json
traces/
